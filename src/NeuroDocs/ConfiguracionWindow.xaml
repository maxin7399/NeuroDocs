<Window x:Class="NeuroDocs.ConfiguracionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración" Width="540" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource FuenteApp}" FontSize="13.5"
        Background="{StaticResource FondoVentanaBrush}"
        Foreground="{StaticResource TextoPrincipalBrush}"
        Icon="/Assets/NeuroDocs.ico">

    <StackPanel>
        <!-- Encabezado morado como la barra de la ventana principal -->
        <Border Background="{StaticResource BarraFondoBrush}" Padding="22,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconoStyle}" Text="&#xE713;" FontSize="18" Margin="0,0,12,0"
                           Foreground="{StaticResource BarraTextoBrush}"/>
                <TextBlock Text="Configuración de Gemini" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource BarraTextoBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Margin="18" Padding="20" CornerRadius="16" Background="{StaticResource FondoTarjetaBrush}"
                BorderBrush="{StaticResource BordeTarjetaBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Clave de API de Gemini" FontSize="14" FontWeight="SemiBold"/>
                <PasswordBox x:Name="ApiKeyBox" Margin="0,8,0,4" VerticalContentAlignment="Center"/>
                <TextBlock x:Name="EstadoClaveText" Style="{StaticResource TextoSecundarioStyle}" TextWrapping="Wrap"/>

                <TextBlock Text="Modelo" FontSize="14" FontWeight="SemiBold" Margin="0,18,0,0"/>
                <ComboBox x:Name="ModeloCombo" IsEditable="True" Margin="0,8,0,4" HorizontalAlignment="Stretch"
                          VerticalContentAlignment="Center"/>
                <TextBlock Style="{StaticResource TextoSecundarioStyle}" TextWrapping="Wrap"
                           Text="Si un modelo deja de estar disponible, escribe el nombre del nuevo."/>

                <TextBlock x:Name="ResultadoPruebaText" TextWrapping="Wrap" Margin="0,16,0,0"/>

                <TextBlock x:Name="VersionText" Style="{StaticResource TextoSecundarioStyle}" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>

        <DockPanel Margin="18,0,18,18" LastChildFill="False">
            <Button x:Name="ProbarButton" Content="Probar conexión" DockPanel.Dock="Left" Click="ProbarButton_Click"/>
            <Button Content="Cancelar" DockPanel.Dock="Right" Margin="10,0,0,0" IsCancel="True"/>
            <Button Content="Guardar" DockPanel.Dock="Right" Style="{StaticResource BotonPrincipalStyle}"
                    IsDefault="True" Click="GuardarButton_Click"/>
        </DockPanel>
    </StackPanel>
</Window>

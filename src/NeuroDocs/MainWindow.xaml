<Window x:Class="NeuroDocs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:NeuroDocs.Controls"
        Title="NeuroDocs" Width="1240" Height="800" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Icon="/Assets/NeuroDocs.ico"
        FontFamily="{StaticResource FuenteApp}" FontSize="13.5"
        Background="{StaticResource FondoVentanaBrush}"
        Foreground="{StaticResource TextoPrincipalBrush}"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Píldora (radio = mitad de la altura) para los pasos y el selector de modo -->
        <Style x:Key="PildoraBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius"
                    Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource RadioPildora}}"/>
        </Style>
        <Style x:Key="PasoStyle" TargetType="Border" BasedOn="{StaticResource PildoraBorderStyle}">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,5,14,5"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <!-- Separador fino entre zonas de una tarjeta -->
        <Style x:Key="SeparadorStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource BordeTarjetaBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Manchas de luz del fondo (violeta arriba a la derecha, azul abajo a la izquierda) -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.92,-0.05" GradientOrigin="0.92,-0.05" RadiusX="0.5" RadiusY="0.55">
                    <GradientStop Color="#55C77DFF" Offset="0"/>
                    <GradientStop Color="#00C77DFF" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="-0.05,1.08" GradientOrigin="-0.05,1.08" RadiusX="0.45" RadiusY="0.55">
                    <GradientStop Color="#447FD4FF" Offset="0"/>
                    <GradientStop Color="#007FD4FF" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid x:Name="RaizGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ───── Barra superior: logo, modo y acciones ───── -->
            <Grid Grid.Row="0" x:Name="BarraGrid">
                <Border Background="{StaticResource BarraFondoBrush}">
                    <Border.Effect>
                        <DropShadowEffect Color="{StaticResource AcentoColor}" BlurRadius="20" ShadowDepth="3"
                                          Direction="270" Opacity="0.45"/>
                    </Border.Effect>
                </Border>
                <DockPanel Margin="24,12" LastChildFill="False">
                    <!-- Logo: la N de nodos del ícono (versión pequeña, sin agujeros), en morado sobre blanco -->
                    <Border x:Name="BarraLogo" DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10"
                            Background="{StaticResource BarraTextoBrush}" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="White" BlurRadius="14" ShadowDepth="0" Opacity="0.7"/>
                        </Border.Effect>
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="88" Height="98">
                                <Path Data="M15,83 L15,15 L71,83 L71,15" Stroke="{StaticResource BarraFondoBrush}" StrokeThickness="13"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Path Fill="{StaticResource BarraFondoBrush}"
                                      Data="M0,83 A15,15 0 1 0 30,83 A15,15 0 1 0 0,83 M0,15 A15,15 0 1 0 30,15 A15,15 0 1 0 0,15 M56,83 A15,15 0 1 0 86,83 A15,15 0 1 0 56,83 M56,15 A15,15 0 1 0 86,15 A15,15 0 1 0 56,15"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel DockPanel.Dock="Left" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="NeuroDocs" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource BarraTextoBrush}"/>
                        <TextBlock Text="Software de apoyo para la rehabilitación neuropsicológica" FontSize="11"
                                   Foreground="{StaticResource BarraTextoSuaveBrush}"/>
                    </StackPanel>

                    <Border DockPanel.Dock="Left" Margin="32,0,0,0" Padding="3" Style="{StaticResource PildoraBorderStyle}"
                            Background="{StaticResource BarraSegmentoBrush}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="PlanModoRadio" GroupName="Modo" IsChecked="True"
                                         Style="{StaticResource SegmentoModoStyle}" Content="Plan de rehabilitación"
                                         Checked="Modo_Checked"/>
                            <RadioButton x:Name="InformeModoRadio" GroupName="Modo"
                                         Style="{StaticResource SegmentoModoStyle}" Content="Informe de evolución"
                                         Checked="Modo_Checked"/>
                        </StackPanel>
                    </Border>

                    <Button DockPanel.Dock="Right" Style="{StaticResource BotonBarraStyle}" Click="ConfiguracionButton_Click"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconoStyle}" Text="&#xE713;" Margin="0,0,8,0"/>
                            <TextBlock Text="Configuración"/>
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotonBarraStyle}" Click="LimpiarButton_Click"
                            ToolTip="Quitar todos los documentos y vaciar los textos" Margin="0,0,4,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconoStyle}" Text="&#xE894;" Margin="0,0,8,0"/>
                            <TextBlock Text="Limpiar"/>
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotonBarraStyle}" Click="BloquearButton_Click"
                            ToolTip="Bloquear NeuroDocs (Ctrl+L)" Margin="0,0,4,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconoStyle}" Text="&#xE72E;" Margin="0,0,8,0"/>
                            <TextBlock Text="Bloquear"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Margin="0,0,16,0" VerticalAlignment="Center"
                               FontSize="11.5" Foreground="{StaticResource BarraTextoSuaveBrush}"/>
                </DockPanel>
            </Grid>

            <!-- ───── Pasos ───── -->
            <StackPanel Grid.Row="1" x:Name="PasosPanel" Orientation="Horizontal" Margin="28,12,28,0"
                        MaxWidth="1240" HorizontalAlignment="Stretch">
                <Border x:Name="Paso1" Style="{StaticResource PasoStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Paso1Circulo" Width="22" Height="22" CornerRadius="11" BorderThickness="1.5" Margin="0,0,8,0">
                            <TextBlock x:Name="Paso1Numero" Text="1" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="Paso1Texto" Text="Documentos" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border x:Name="Paso2" Style="{StaticResource PasoStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Paso2Circulo" Width="22" Height="22" CornerRadius="11" BorderThickness="1.5" Margin="0,0,8,0">
                            <TextBlock x:Name="Paso2Numero" Text="2" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="Paso2Texto" Text="Funciones" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border x:Name="Paso3" Style="{StaticResource PasoStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Paso3Circulo" Width="22" Height="22" CornerRadius="11" BorderThickness="1.5" Margin="0,0,8,0">
                            <TextBlock x:Name="Paso3Numero" Text="3" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="Paso3Texto" Text="Generar" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ───── Contenido: una columna centrada, como el prototipo ───── -->
            <Grid Grid.Row="2" Margin="24,10,24,0" MaxWidth="1248">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Paso 1 (compartido): documentos del paciente -->
                <c:Tarjeta x:Name="TarjetaDocumentos" Margin="4,4,4,12" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Título y, a la derecha, la emisión del plan (así no ocupa una fila propia) -->
                        <DockPanel Grid.ColumnSpan="3" Margin="2,0,4,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,10,0" Background="{StaticResource AcentoSuaveBrush}">
                                    <TextBlock Style="{StaticResource IconoStyle}" FontSize="13" Text="&#xE787;"
                                               Foreground="{StaticResource AcentoBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Emisión del plan" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ComboBox x:Name="MesCombo" Width="140"
                                          DisplayMemberPath="Nombre" SelectedValuePath="Numero"/>
                                <ComboBox x:Name="AnioCombo" Width="96" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="Documentos del paciente" Style="{StaticResource TituloPasoStyle}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Examen(es) -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.RowSpan="2">
                            <c:SelectorArchivo x:Name="HistoriaSelector" Titulo="Examen (ECC, AD4, AD5)"
                                               RutaCambiada="DocumentoPaciente_RutaCambiada"/>
                            <Button x:Name="AgregarExamenButton" HorizontalAlignment="Right" Margin="0,-2,6,0"
                                    Style="{StaticResource BotonEnlaceStyle}"
                                    ToolTip="Agregar otro examen del mismo paciente" Click="AgregarExamenButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconoStyle}" FontSize="11" Text="&#xE710;" Margin="0,0,6,0"/>
                                    <TextBlock Text="Agregar examen"/>
                                </StackPanel>
                            </Button>
                            <c:SelectorArchivo x:Name="Historia2Selector" Titulo="Segundo examen (opcional)"
                                               PermiteQuitar="True" PermiteOcultar="True" Visibility="Collapsed"
                                               RutaCambiada="DocumentoPaciente_RutaCambiada"/>
                        </StackPanel>

                        <!-- Orden -->
                        <c:SelectorArchivo Grid.Row="1" Grid.Column="2" x:Name="OrdenSelector" Titulo="Orden (servicio o cobro)"
                                           RutaCambiada="DocumentoPaciente_RutaCambiada"/>

                        <!-- Resumen del paciente: bajo la orden, a la altura de "Agregar examen" -->
                        <Border Grid.Row="2" Grid.Column="2" x:Name="ResumenBorder" Visibility="Collapsed" Margin="0,4,0,0"
                                VerticalAlignment="Top"
                                Background="{StaticResource AcentoSuaveBrush}" CornerRadius="12" Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="ResumenAvatar" Width="30" Height="30" CornerRadius="15" Margin="0,0,10,0"
                                        Background="{StaticResource AcentoBrush}" VerticalAlignment="Center">
                                    <TextBlock x:Name="ResumenIniciales" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="ResumenNombreText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ResumenDetalleText" Style="{StaticResource TextoSecundarioStyle}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="2" x:Name="VerDatosButton" Content="Ver datos"
                                        Style="{StaticResource BotonEnlaceStyle}" Margin="12,0,0,0" Click="VerDatosButton_Click"/>
                                <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" x:Name="LecturaProgress" IsIndeterminate="True"
                                             Height="3" Margin="0,6,0,0" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>
                </c:Tarjeta>

                <!-- ───── Plan de rehabilitación: funciones con IA + generar ───── -->
                <c:Tarjeta Grid.Row="1" x:Name="TarjetaPlan" Margin="4,0,4,14" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="90"/>
                        </Grid.RowDefinitions>

                        <!-- Título y acciones: sugerir, guardar Word y generar, arriba para dejar el alto a las listas -->
                        <DockPanel Grid.ColumnSpan="3" Margin="2,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <StackPanel x:Name="PensandoPlan" Orientation="Horizontal" Margin="0,0,14,0"
                                            VerticalAlignment="Center" Visibility="Collapsed">
                                    <Ellipse Style="{StaticResource PuntoNeuronaStyle}"/>
                                    <Ellipse Style="{StaticResource PuntoNeuronaStyle}"/>
                                    <Ellipse Style="{StaticResource PuntoNeuronaStyle}"/>
                                    <Ellipse Style="{StaticResource PuntoNeuronaStyle}"/>
                                    <TextBlock Text="Analizando los informes…" Margin="6,0,0,0"
                                               Style="{StaticResource TextoSecundarioStyle}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button x:Name="SugerirIAButton" Style="{StaticResource BotonPrincipalStyle}"
                                        IsEnabled="False" Click="SugerirIAButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconoStyle}" FontSize="14" Text="&#xEA80;" Margin="0,0,8,0"/>
                                        <TextBlock Text="Sugerir con IA"/>
                                    </StackPanel>
                                </Button>
                                <Border Width="1" Height="26" Margin="18,0" Background="{StaticResource BordeTarjetaBrush}"/>
                                <CheckBox x:Name="GuardarWordCheckBox" IsChecked="True" Margin="0,0,14,0"
                                          Content="Guardar también el Word" VerticalAlignment="Center"
                                          ToolTip="Además del PDF, guarda el documento en Word (.docx)"/>
                                <Button x:Name="GenerarButton" IsEnabled="False"
                                        Style="{StaticResource BotonPrincipalStyle}" Click="GenerarButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconoStyle}" FontSize="14" Text="&#xE74E;" Margin="0,0,8,0"/>
                                        <TextBlock Text="Generar plan PDF"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Funciones evaluadas con IA" Style="{StaticResource TituloPasoStyle}"/>
                                <TextBlock Style="{StaticResource IconoStyle}" FontSize="13" Text="&#xE946;" Margin="8,1,0,0"
                                           Foreground="{StaticResource TextoSecundarioBrush}" Background="Transparent"
                                           ToolTip="Estos documentos solo se envían a Gemini para sugerir conservados y alterados."/>
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <c:SelectorArchivo x:Name="Informe1Selector" Titulo="Información para la IA 1"
                                               Extensiones="pdf,docx,doc,rtf,txt,png,jpg,jpeg"
                                               Filtro="Informe (*.pdf;*.docx;*.rtf;*.txt;*.png;*.jpg)|*.pdf;*.docx;*.doc;*.rtf;*.txt;*.png;*.jpg;*.jpeg"
                                               PermiteQuitar="True" RutaCambiada="Informe_RutaCambiada"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">
                            <Button x:Name="AgregarInformeButton" HorizontalAlignment="Left" Margin="6,0,0,0"
                                    Style="{StaticResource BotonEnlaceStyle}"
                                    ToolTip="Agregar otro documento para la IA" Click="AgregarInformeButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconoStyle}" FontSize="11" Text="&#xE710;" Margin="0,0,6,0"/>
                                    <TextBlock Text="Agregar otro documento para la IA"/>
                                </StackPanel>
                            </Button>
                            <c:SelectorArchivo x:Name="Informe2Selector" Titulo="Información para la IA 2 (opcional)"
                                               PermiteOcultar="True" Visibility="Collapsed"
                                               Extensiones="pdf,docx,doc,rtf,txt,png,jpg,jpeg"
                                               Filtro="Informe (*.pdf;*.docx;*.rtf;*.txt;*.png;*.jpg)|*.pdf;*.docx;*.doc;*.rtf;*.txt;*.png;*.jpg;*.jpeg"
                                               PermiteQuitar="True" RutaCambiada="Informe_RutaCambiada"/>
                        </StackPanel>

                        <!-- Conservados | Alterados -->
                        <Grid Grid.Row="2" Grid.ColumnSpan="3" x:Name="ColumnasPlan" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Column="0" Margin="2,0,2,8">
                                <TextBlock x:Name="ConservadosConteo" DockPanel.Dock="Right"
                                           Style="{StaticResource TextoSecundarioStyle}" VerticalAlignment="Center"/>
                                <Ellipse Style="{StaticResource PuntoColumnaStyle}" Fill="{StaticResource ConservadosPuntoBrush}"/>
                                <TextBlock Text="Conservados" Style="{StaticResource TituloPasoStyle}"/>
                                <TextBlock Text="  · uno por línea" Style="{StaticResource TextoSecundarioStyle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBox Grid.Row="1" Grid.Column="0" x:Name="ConservadosTextBox"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" Padding="12,10" FontSize="13.5"
                                     Background="{StaticResource ConservadosFondoBrush}"
                                     BorderBrush="{StaticResource ConservadosBordeBrush}"
                                     TextChanged="Funciones_TextChanged">
                                <TextBox.Resources>
                                    <StaticResource x:Key="TextControlBackground" ResourceKey="ConservadosFondoBrush"/>
                                    <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="ConservadosFondoBrush"/>
                                    <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="ConservadosFondoBrush"/>
                                    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="ConservadosBordeBrush"/>
                                    <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="AcentoBrush"/>
                                </TextBox.Resources>
                            </TextBox>

                            <DockPanel Grid.Column="2" Margin="2,0,2,8">
                                <TextBlock x:Name="AlteradosConteo" DockPanel.Dock="Right"
                                           Style="{StaticResource TextoSecundarioStyle}" VerticalAlignment="Center"/>
                                <Ellipse Style="{StaticResource PuntoColumnaStyle}" Fill="{StaticResource AlteradosPuntoBrush}"/>
                                <TextBlock Text="Alterados" Style="{StaticResource TituloPasoStyle}"/>
                                <TextBlock Text="  · uno por línea" Style="{StaticResource TextoSecundarioStyle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBox Grid.Row="1" Grid.Column="2" x:Name="AlteradosTextBox"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" Padding="12,10" FontSize="13.5"
                                     Background="{StaticResource AlteradosFondoBrush}"
                                     BorderBrush="{StaticResource AlteradosBordeBrush}"
                                     TextChanged="Funciones_TextChanged">
                                <TextBox.Resources>
                                    <StaticResource x:Key="TextControlBackground" ResourceKey="AlteradosFondoBrush"/>
                                    <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="AlteradosFondoBrush"/>
                                    <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="AlteradosFondoBrush"/>
                                    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="AlteradosBordeBrush"/>
                                    <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="AcentoBrush"/>
                                </TextBox.Resources>
                            </TextBox>
                        </Grid>

                    </Grid>
                </c:Tarjeta>

                <!-- ───── Informe de evolución: evoluciones con IA + generar ───── -->
                <c:Tarjeta Grid.Row="1" x:Name="TarjetaInforme" Margin="4,0,4,14" Padding="18,14" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="90"/>
                        </Grid.RowDefinitions>

                        <!-- Título y acciones: sugerir, guardar Word y generar -->
                        <DockPanel Grid.ColumnSpan="3" Margin="2,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <StackPanel x:Name="PensandoInforme" Orientation="Horizontal" Margin="0,0,14,0"
                                            VerticalAlignment="Center" Visibility="Collapsed">
                                    <Ellipse Style="{StaticResource PuntoNeuronaStyle}"/>
                                    <Ellipse Style="{StaticResource PuntoNeuronaStyle}"/>
                                    <Ellipse Style="{StaticResource PuntoNeuronaStyle}"/>
                                    <Ellipse Style="{StaticResource PuntoNeuronaStyle}"/>
                                    <TextBlock Text="Redactando el informe…" Margin="6,0,0,0"
                                               Style="{StaticResource TextoSecundarioStyle}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button x:Name="RedactarIAButton" Style="{StaticResource BotonPrincipalStyle}"
                                        IsEnabled="False" Click="RedactarIAButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconoStyle}" FontSize="14" Text="&#xEA80;" Margin="0,0,8,0"/>
                                        <TextBlock Text="Sugerir con IA"/>
                                    </StackPanel>
                                </Button>
                                <Border Width="1" Height="26" Margin="18,0" Background="{StaticResource BordeTarjetaBrush}"/>
                                <CheckBox x:Name="GuardarWordInformeCheckBox" IsChecked="True" Margin="0,0,14,0"
                                          Content="Guardar también el Word" VerticalAlignment="Center"
                                          ToolTip="Además del PDF, guarda el documento en Word (.docx)"/>
                                <Button x:Name="GenerarInformeButton" IsEnabled="False"
                                        Style="{StaticResource BotonPrincipalStyle}" Click="GenerarInformeButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconoStyle}" FontSize="14" Text="&#xE74E;" Margin="0,0,8,0"/>
                                        <TextBlock Text="Generar informe PDF"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Evaluación del profesional" Style="{StaticResource TituloPasoStyle}"/>
                                <TextBlock Style="{StaticResource IconoStyle}" FontSize="13" Text="&#xE946;" Margin="8,1,0,0"
                                           Foreground="{StaticResource TextoSecundarioBrush}" Background="Transparent"
                                           ToolTip="Las evoluciones se envían a Gemini como texto para redactar el informe."/>
                            </StackPanel>
                        </DockPanel>

                        <c:SelectorArchivo Grid.Row="1" Grid.Column="0" x:Name="EvaluacionSelector"
                                           Titulo="Evoluciones (RTF, Word, PDF o TXT)" PermiteQuitar="True"
                                           Extensiones="rtf,docx,doc,pdf,txt"
                                           Filtro="Evaluación (*.rtf;*.docx;*.doc;*.pdf;*.txt)|*.rtf;*.docx;*.doc;*.pdf;*.txt"
                                           RutaCambiada="Evaluacion_RutaCambiada"/>

                        <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock Text="Tipo de informe" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TipoMensualRadio" GroupName="TipoInforme" IsChecked="True"
                                             Content="Evolución mensual · continúa" Margin="0,0,18,0"
                                             Checked="TipoInforme_Checked"/>
                                <RadioButton x:Name="TipoFinalRadio" GroupName="TipoInforme"
                                             Content="Informe final · cierre"
                                             Checked="TipoInforme_Checked"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Condición actual | Plan actual -->
                        <Grid Grid.Row="2" Grid.ColumnSpan="3" x:Name="ColumnasInforme" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Column="0" Margin="2,0,2,8">
                                <TextBlock x:Name="CondicionConteo" DockPanel.Dock="Right"
                                           Style="{StaticResource TextoSecundarioStyle}" VerticalAlignment="Center"/>
                                <Ellipse Style="{StaticResource PuntoColumnaStyle}" Fill="{StaticResource InformePuntoBrush}"/>
                                <TextBlock Text="Condición actual" Style="{StaticResource TituloPasoStyle}"/>
                            </DockPanel>
                            <TextBox Grid.Row="1" Grid.Column="0" x:Name="CondicionTextBox"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" Padding="12,10" FontSize="13.5"
                                     Background="{StaticResource InformeFondoBrush}"
                                     BorderBrush="{StaticResource InformeBordeBrush}"
                                     TextChanged="Informe_TextChanged">
                                <TextBox.Resources>
                                    <StaticResource x:Key="TextControlBackground" ResourceKey="InformeFondoBrush"/>
                                    <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="InformeFondoBrush"/>
                                    <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="InformeFondoBrush"/>
                                    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="InformeBordeBrush"/>
                                    <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="AcentoBrush"/>
                                </TextBox.Resources>
                            </TextBox>

                            <DockPanel Grid.Column="2" Margin="2,0,2,8">
                                <TextBlock x:Name="PlanConteo" DockPanel.Dock="Right"
                                           Style="{StaticResource TextoSecundarioStyle}" VerticalAlignment="Center"/>
                                <Ellipse Style="{StaticResource PuntoColumnaStyle}" Fill="{StaticResource InformePuntoBrush}"/>
                                <TextBlock Text="Plan actual" Style="{StaticResource TituloPasoStyle}"/>
                            </DockPanel>
                            <TextBox Grid.Row="1" Grid.Column="2" x:Name="PlanTextBox"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" Padding="12,10" FontSize="13.5"
                                     Background="{StaticResource InformeFondoBrush}"
                                     BorderBrush="{StaticResource InformeBordeBrush}"
                                     TextChanged="Informe_TextChanged">
                                <TextBox.Resources>
                                    <StaticResource x:Key="TextControlBackground" ResourceKey="InformeFondoBrush"/>
                                    <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="InformeFondoBrush"/>
                                    <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="InformeFondoBrush"/>
                                    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="InformeBordeBrush"/>
                                    <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="AcentoBrush"/>
                                </TextBox.Resources>
                            </TextBox>
                        </Grid>

                    </Grid>
                </c:Tarjeta>
            </Grid>

            <!-- ───── Barra de avisos ───── -->
            <Border Grid.Row="3" x:Name="AvisoBorder" Visibility="Collapsed" CornerRadius="14" MaxWidth="1240"
                    Padding="14,10" Margin="28,0,28,18" BorderThickness="1" BorderBrush="#1F26193A">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AvisoIconoText" Style="{StaticResource IconoStyle}" FontSize="18"
                               Margin="0,0,12,0" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="AvisoText" TextWrapping="Wrap"/>
                        <!-- Solo cuando la orden no trae el tiempo de terapia: permite corregir el valor por defecto -->
                        <StackPanel x:Name="TiempoTerapiaPanel" Orientation="Horizontal" Margin="0,8,0,2" Visibility="Collapsed">
                            <TextBlock Text="Sesiones mensuales" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="SesionesTerapiaCombo" Width="76" SelectionChanged="TiempoTerapia_Changed"
                                      AutomationProperties.Name="Sesiones mensuales"/>
                            <TextBlock Text="Meses" VerticalAlignment="Center" Margin="18,0,8,0"/>
                            <ComboBox x:Name="MesesTerapiaCombo" Width="76" SelectionChanged="TiempoTerapia_Changed"
                                      AutomationProperties.Name="Meses de terapia"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="AvisoAccionButton" Visibility="Collapsed" Margin="12,0,0,0"
                            Click="AvisoAccionButton_Click"/>
                    <Button Grid.Column="3" ToolTip="Cerrar" Margin="8,0,0,0" Padding="8,6" Click="CerrarAvisoButton_Click">
                        <TextBlock Style="{StaticResource IconoStyle}" FontSize="11" Text="&#xE711;"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ───── Bloqueo: pide la contraseña al abrir, al pulsar "Bloquear" y tras un rato sin uso.
             Tapa toda la ventana sin borrar nada de lo cargado. ───── -->
        <Grid x:Name="BloqueoOverlay" Background="{StaticResource FondoVentanaBrush}">
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.45" RadiusY="0.6">
                        <GradientStop Color="#40C77DFF" Offset="0"/>
                        <GradientStop Color="#00C77DFF" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <c:Tarjeta x:Name="BloqueoTarjeta" Width="380" Padding="30,28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <c:Tarjeta.RenderTransform>
                    <TranslateTransform x:Name="BloqueoSacudida"/>
                </c:Tarjeta.RenderTransform>
                <StackPanel>
                    <Border x:Name="BloqueoLogo" Width="72" Height="72" CornerRadius="20" HorizontalAlignment="Center"
                            Background="{StaticResource BarraFondoBrush}">
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource BrilloColor}" BlurRadius="24" ShadowDepth="0" Opacity="0.7"/>
                        </Border.Effect>
                        <Viewbox Width="46" Height="46">
                            <Canvas Width="74" Height="86">
                                <Path Data="M11,75 L11,11 L63,75 L63,11" Stroke="{StaticResource BarraTextoBrush}" StrokeThickness="7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Path Fill="{StaticResource BarraTextoBrush}"
                                      Data="M0,75 A11,11 0 1 0 22,75 A11,11 0 1 0 0,75 M0,11 A11,11 0 1 0 22,11 A11,11 0 1 0 0,11 M52,75 A11,11 0 1 0 74,75 A11,11 0 1 0 52,75 M52,11 A11,11 0 1 0 74,11 A11,11 0 1 0 52,11"/>
                                <Path Fill="{StaticResource BarraFondoBrush}"
                                      Data="M6.5,75 A4.5,4.5 0 1 0 15.5,75 A4.5,4.5 0 1 0 6.5,75 M6.5,11 A4.5,4.5 0 1 0 15.5,11 A4.5,4.5 0 1 0 6.5,11 M58.5,75 A4.5,4.5 0 1 0 67.5,75 A4.5,4.5 0 1 0 58.5,75 M58.5,11 A4.5,4.5 0 1 0 67.5,11 A4.5,4.5 0 1 0 58.5,11"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock x:Name="BloqueoTituloText" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock x:Name="BloqueoSubtituloText" Style="{StaticResource TextoSecundarioStyle}" Margin="0,6,0,18"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>

                    <TextBlock x:Name="ContrasenaEtiqueta" Text="Contraseña" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="ContrasenaBox" KeyDown="ContrasenaBox_KeyDown"
                                 AutomationProperties.Name="Contraseña"/>
                    <StackPanel x:Name="ConfirmarPanel" Visibility="Collapsed">
                        <TextBlock Text="Repite la contraseña" FontWeight="SemiBold" Margin="0,12,0,6"/>
                        <PasswordBox x:Name="ConfirmarBox" KeyDown="ContrasenaBox_KeyDown"
                                     AutomationProperties.Name="Repite la contraseña"/>
                    </StackPanel>

                    <TextBlock x:Name="BloqueoErrorText" Foreground="{StaticResource AvisoErrorIconoBrush}" TextWrapping="Wrap"
                               Margin="0,10,0,0" Visibility="Collapsed"/>

                    <Button x:Name="EntrarButton" Style="{StaticResource BotonPrincipalStyle}" Margin="0,20,0,0"
                            HorizontalAlignment="Stretch" Click="EntrarButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconoStyle}" FontSize="14" Text="&#xE785;" Margin="0,0,8,0"/>
                            <TextBlock x:Name="EntrarTexto" Text="Entrar"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </c:Tarjeta>
        </Grid>

        <!-- ───── Animación de entrada: el logo se enciende y viaja a la barra ───── -->
        <Grid x:Name="IntroOverlay" IsHitTestVisible="False">
            <Rectangle x:Name="IntroFondo" Fill="{StaticResource FondoVentanaBrush}"/>
            <Border x:Name="IntroLogo" Width="96" Height="96" CornerRadius="26" Opacity="0"
                    Background="{StaticResource BarraFondoBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="IntroEscala" ScaleX="0.6" ScaleY="0.6"/>
                        <TranslateTransform x:Name="IntroMovimiento"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect x:Name="IntroBrillo" Color="{StaticResource BrilloColor}" BlurRadius="0"
                                      ShadowDepth="0" Opacity="0.9"/>
                </Border.Effect>
                <!-- La N de nodos del ícono, versión grande con agujeros -->
                <Viewbox Width="62" Height="62">
                    <Canvas Width="74" Height="86">
                        <Path Data="M11,75 L11,11 L63,75 L63,11" Stroke="{StaticResource BarraTextoBrush}" StrokeThickness="7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        <Path Fill="{StaticResource BarraTextoBrush}"
                              Data="M0,75 A11,11 0 1 0 22,75 A11,11 0 1 0 0,75 M0,11 A11,11 0 1 0 22,11 A11,11 0 1 0 0,11 M52,75 A11,11 0 1 0 74,75 A11,11 0 1 0 52,75 M52,11 A11,11 0 1 0 74,11 A11,11 0 1 0 52,11"/>
                        <Path Fill="{StaticResource BarraFondoBrush}"
                              Data="M6.5,75 A4.5,4.5 0 1 0 15.5,75 A4.5,4.5 0 1 0 6.5,75 M6.5,11 A4.5,4.5 0 1 0 15.5,11 A4.5,4.5 0 1 0 6.5,11 M58.5,75 A4.5,4.5 0 1 0 67.5,75 A4.5,4.5 0 1 0 58.5,75 M58.5,11 A4.5,4.5 0 1 0 67.5,11 A4.5,4.5 0 1 0 58.5,11"/>
                    </Canvas>
                </Viewbox>
            </Border>
        </Grid>
    </Grid>
</Window>

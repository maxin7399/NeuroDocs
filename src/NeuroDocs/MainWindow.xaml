<Window x:Class="NeuroDocs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeuroDocs" Height="820" Width="900">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0 título -->
            <RowDefinition Height="Auto"/>
            <!-- 1 historia clínica -->
            <RowDefinition Height="Auto"/>
            <!-- 2 orden de servicio -->
            <RowDefinition Height="Auto"/>
            <!-- 3 emisión del plan -->
            <RowDefinition Height="Auto"/>
            <!-- 4 informes para la IA -->
            <RowDefinition Height="*"/>
            <!-- 5 funciones evaluadas -->
            <RowDefinition Height="Auto"/>
            <!-- 6 botones -->
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <Button Content="⚙ Configuración" DockPanel.Dock="Right" Width="140" Height="32"
            VerticalAlignment="Center" Click="ConfiguracionButton_Click"/>
            <TextBlock Text="NeuroDocs" FontSize="28" FontWeight="Bold"/>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Historia clínica (ECC)" FontSize="15" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Seleccionar..." Width="120" Height="32"
                    Click="SeleccionarHistoriaButton_Click"/>
            <TextBlock Grid.Column="2" x:Name="HistoriaRutaText" Text="Ninguno" Margin="12,0,0,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Orden de servicio (CUPS)" FontSize="15" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Seleccionar..." Width="120" Height="32"
                    Click="SeleccionarOrdenButton_Click"/>
            <TextBlock Grid.Column="2" x:Name="OrdenRutaText" Text="Ninguno" Margin="12,0,0,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Emisión del plan" FontSize="15" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="MesCombo" Width="130" Height="30"
                      DisplayMemberPath="Nombre" SelectedValuePath="Numero"
                      VerticalContentAlignment="Center"/>
            <ComboBox Grid.Column="2" x:Name="AnioCombo" Width="90" Height="30" Margin="10,0,0,0"
                      VerticalContentAlignment="Center"/>
        </Grid>

        <GroupBox Grid.Row="4" Header="Informes para la IA (solo se envían a Gemini)"
                  Margin="0,0,0,15" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Text="Informe 1" FontSize="15" VerticalAlignment="Center"/>
                <Button Grid.Row="0" Grid.Column="1" Content="Seleccionar..." Width="120" Height="32"
                        Tag="0" Click="SeleccionarInforme_Click"/>
                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="Informe1RutaText" Text="Ninguno"
                           Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Row="0" Grid.Column="3" Content="Quitar" Width="70" Height="32"
                        Tag="0" Click="QuitarInforme_Click"/>

                <TextBlock Grid.Row="1" Text="Informe 2 (opcional)" FontSize="15"
                           VerticalAlignment="Center" Margin="0,8,0,0"/>
                <Button Grid.Row="1" Grid.Column="1" Content="Seleccionar..." Width="120" Height="32"
                        Margin="0,8,0,0" Tag="1" Click="SeleccionarInforme_Click"/>
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="Informe2RutaText" Text="Ninguno"
                           Margin="12,8,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Row="1" Grid.Column="3" Content="Quitar" Width="70" Height="32"
                        Margin="0,8,0,0" Tag="1" Click="QuitarInforme_Click"/>

                <Button Grid.Row="2" Grid.ColumnSpan="2" x:Name="SugerirIAButton" Content="Sugerir con IA"
                        Width="150" Height="36" HorizontalAlignment="Left" Margin="0,12,0,0"
                        IsEnabled="False" Click="SugerirIAButton_Click"/>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="5" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Conservados (uno por línea)"
                       FontSize="15" Margin="0,0,0,5"/>
            <TextBox Grid.Row="1" Grid.Column="0" x:Name="ConservadosTextBox"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Alterados (uno por línea)"
                       FontSize="15" Margin="0,0,0,5"/>
            <TextBox Grid.Row="1" Grid.Column="2" x:Name="AlteradosTextBox"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal">
            <Button x:Name="LeerButton" Content="Leer documentos" Width="180" Height="36"
                    IsEnabled="False" Click="LeerButton_Click"/>
            <Button x:Name="GenerarButton" Content="Generar plan (PDF)" Width="180" Height="36"
                    Margin="10,0,0,0" IsEnabled="False" Click="GenerarButton_Click"/>
            <CheckBox x:Name="GuardarWordCheckBox" Content="Guardar también el Word (.docx)"
                      Margin="15,0,0,0" VerticalAlignment="Center" IsChecked="True"/>
        </StackPanel>
    </Grid>
</Window>
<Window x:Class="NeuroDocs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:NeuroDocs.Controls"
        Title="NeuroDocs" Width="1240" Height="800" MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Icon="/Assets/NeuroDocs.ico"
        Background="{StaticResource FondoVentanaBrush}"
        Foreground="{StaticResource TextoPrincipalBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ───── Encabezado ───── -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button ToolTip="Quitar todos los documentos y vaciar los textos" Margin="0,0,8,0"
                        Click="LimpiarButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconoStyle}" Text="&#xE894;" Margin="0,0,8,0"/>
                        <TextBlock Text="Limpiar"/>
                    </StackPanel>
                </Button>
                <Button Click="ConfiguracionButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconoStyle}" Text="&#xE713;" Margin="0,0,8,0"/>
                        <TextBlock Text="Configuración"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/NeuroDocs-256.png" Width="46" Height="46" Margin="0,0,14,0"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="NeuroDocs" FontSize="26" FontWeight="Bold"/>
                        <TextBlock x:Name="VersionText" Style="{StaticResource TextoSecundarioStyle}"
                                   VerticalAlignment="Bottom" Margin="10,0,0,6"/>
                    </StackPanel>
                    <TextBlock Text="Planes e informes de rehabilitación neuropsicológica cognitiva"
                               Style="{StaticResource TextoSecundarioStyle}" FontSize="13"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- ───── Contenido ───── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Paso 1 (compartido) -->
                    <Border Style="{StaticResource TarjetaStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Style="{StaticResource NumeroPasoStyle}">
                                    <TextBlock Text="1" Foreground="White" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Documentos del paciente" Style="{StaticResource TituloPasoStyle}"/>
                            </StackPanel>

                            <c:SelectorArchivo x:Name="HistoriaSelector" Titulo="Examen (ECC, AD4, AD5)"
                                               RutaCambiada="DocumentoPaciente_RutaCambiada"/>
                            <c:SelectorArchivo x:Name="OrdenSelector" Titulo="Orden (servicio o cobro)"
                                               RutaCambiada="DocumentoPaciente_RutaCambiada"/>

                            <Grid Margin="10,4,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource IconoStyle}" FontSize="20" Text="&#xE787;"
                                           Foreground="{StaticResource TextoSecundarioBrush}" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="Emisión del plan" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="2" x:Name="MesCombo" Width="140"
                                          DisplayMemberPath="Nombre" SelectedValuePath="Numero"/>
                                <ComboBox Grid.Column="3" x:Name="AnioCombo" Width="100" Margin="8,0,0,0"/>
                            </Grid>

                            <Border x:Name="ResumenBorder" Visibility="Collapsed" Margin="0,14,0,0"
                                    Background="{StaticResource AcentoSuaveBrush}" CornerRadius="6" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource IconoStyle}" FontSize="20" Text="&#xE77B;"
                                               Foreground="{StaticResource AcentoBrush}" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="ResumenNombreText" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="ResumenDetalleText" Style="{StaticResource TextoSecundarioStyle}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" x:Name="VerDatosButton" Content="Ver datos"
                                            Style="{StaticResource BotonEnlaceStyle}" Margin="12,0,0,0"
                                            Click="VerDatosButton_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Plan de rehabilitación: pasos 2 y 3 -->
                    <StackPanel x:Name="PlanIzquierda">
                        <Border Style="{StaticResource TarjetaStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Style="{StaticResource NumeroPasoStyle}">
                                        <TextBlock Text="2" Foreground="White" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Funciones evaluadas con IA" Style="{StaticResource TituloPasoStyle}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource TextoSecundarioStyle}" TextWrapping="Wrap"
                                           Margin="36,0,0,10"
                                           Text="Estos documentos solo se envían a Gemini para sugerir conservados y alterados."/>

                                <c:SelectorArchivo x:Name="Informe1Selector" Titulo="Información para la IA 1"
                                                   PermiteQuitar="True" RutaCambiada="Informe_RutaCambiada"/>
                                <c:SelectorArchivo x:Name="Informe2Selector" Titulo="Información para la IA 2 (opcional)"
                                                   PermiteQuitar="True" RutaCambiada="Informe_RutaCambiada"/>

                                <Button x:Name="SugerirIAButton" HorizontalAlignment="Left" Margin="10,8,0,0"
                                        IsEnabled="False" Click="SugerirIAButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconoStyle}" Text="&#xEA80;" Margin="0,0,8,0"/>
                                        <TextBlock Text="Sugerir con IA"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource TarjetaStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Style="{StaticResource NumeroPasoStyle}">
                                        <TextBlock Text="3" Foreground="White" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Generar plan" Style="{StaticResource TituloPasoStyle}"/>
                                </StackPanel>
                                <DockPanel>
                                    <Button x:Name="GenerarButton" DockPanel.Dock="Right" IsEnabled="False"
                                            Style="{StaticResource BotonPrincipalStyle}" Click="GenerarButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource IconoStyle}" Text="&#xE74E;" Margin="0,0,8,0"/>
                                            <TextBlock Text="Generar plan PDF"/>
                                        </StackPanel>
                                    </Button>
                                    <CheckBox x:Name="GuardarWordCheckBox" IsChecked="True"
                                              Content="Guardar también el Word (.docx)" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Informe de evolución: pasos 2 y 3 -->
                    <StackPanel x:Name="InformeIzquierda" Visibility="Collapsed">
                        <Border Style="{StaticResource TarjetaStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Style="{StaticResource NumeroPasoStyle}">
                                        <TextBlock Text="2" Foreground="White" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Evaluación del profesional" Style="{StaticResource TituloPasoStyle}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource TextoSecundarioStyle}" TextWrapping="Wrap"
                                           Margin="36,0,0,10"
                                           Text="Las evoluciones se envían a Gemini como texto para redactar el informe."/>

                                <c:SelectorArchivo x:Name="EvaluacionSelector" Titulo="Evoluciones (RTF, Word, PDF o TXT)"
                                                   PermiteQuitar="True"
                                                   Extensiones="rtf,docx,doc,pdf,txt"
                                                   Filtro="Evaluación (*.rtf;*.docx;*.doc;*.pdf;*.txt)|*.rtf;*.docx;*.doc;*.pdf;*.txt"
                                                   RutaCambiada="Evaluacion_RutaCambiada"/>

                                <TextBlock Text="Tipo de informe" FontWeight="SemiBold" Margin="10,10,0,4"/>
                                <RadioButton x:Name="TipoMensualRadio" GroupName="TipoInforme" IsChecked="True"
                                             Content="Evolución mensual · continúa el proceso" Margin="10,2"
                                             Checked="TipoInforme_Checked"/>
                                <RadioButton x:Name="TipoFinalRadio" GroupName="TipoInforme"
                                             Content="Informe final · cierre del proceso" Margin="10,2"
                                             Checked="TipoInforme_Checked"/>

                                <Button x:Name="RedactarIAButton" HorizontalAlignment="Left" Margin="10,12,0,0"
                                        IsEnabled="False" Click="RedactarIAButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconoStyle}" Text="&#xE70F;" Margin="0,0,8,0"/>
                                        <TextBlock Text="Redactar con IA"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource TarjetaStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Style="{StaticResource NumeroPasoStyle}">
                                        <TextBlock Text="3" Foreground="White" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Generar informe" Style="{StaticResource TituloPasoStyle}"/>
                                </StackPanel>
                                <DockPanel>
                                    <Button x:Name="GenerarInformeButton" DockPanel.Dock="Right" IsEnabled="False"
                                            Style="{StaticResource BotonPrincipalStyle}" Click="GenerarInformeButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource IconoStyle}" Text="&#xE74E;" Margin="0,0,8,0"/>
                                            <TextBlock Text="Generar informe PDF"/>
                                        </StackPanel>
                                    </Button>
                                    <CheckBox x:Name="GuardarWordInformeCheckBox" IsChecked="True"
                                              Content="Guardar también el Word (.docx)" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Panel derecho con pestañas: también decide qué pasos se ven a la izquierda -->
            <Border Grid.Column="2" Style="{StaticResource TarjetaStyle}" Margin="0">
                <TabControl x:Name="ModoTabs" SelectionChanged="ModoTabs_SelectionChanged"
                        ItemContainerStyle="{StaticResource PestanaStyle}">
                    <TabItem Header="Plan de rehabilitación">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock x:Name="ConservadosConteo" DockPanel.Dock="Right"
                                           Style="{StaticResource TextoSecundarioStyle}" VerticalAlignment="Center"/>
                                <TextBlock Text="Conservados" Style="{StaticResource TituloPasoStyle}"/>
                                <TextBlock Text="  · uno por línea" Style="{StaticResource TextoSecundarioStyle}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBox Grid.Row="1" x:Name="ConservadosTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                     Margin="0,0,0,18" TextChanged="Funciones_TextChanged"/>

                            <DockPanel Grid.Row="2" Margin="0,0,0,8">
                                <TextBlock x:Name="AlteradosConteo" DockPanel.Dock="Right"
                                           Style="{StaticResource TextoSecundarioStyle}" VerticalAlignment="Center"/>
                                <TextBlock Text="Alterados" Style="{StaticResource TituloPasoStyle}"/>
                                <TextBlock Text="  · uno por línea" Style="{StaticResource TextoSecundarioStyle}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBox Grid.Row="3" x:Name="AlteradosTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                     TextChanged="Funciones_TextChanged"/>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Informe de evolución">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="3*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="2*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock x:Name="CondicionConteo" DockPanel.Dock="Right"
                                           Style="{StaticResource TextoSecundarioStyle}" VerticalAlignment="Center"/>
                                <TextBlock Text="Condición actual" Style="{StaticResource TituloPasoStyle}"/>
                            </DockPanel>
                            <TextBox Grid.Row="1" x:Name="CondicionTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                     Margin="0,0,0,18" TextChanged="Informe_TextChanged"/>

                            <DockPanel Grid.Row="2" Margin="0,0,0,8">
                                <TextBlock x:Name="PlanConteo" DockPanel.Dock="Right"
                                           Style="{StaticResource TextoSecundarioStyle}" VerticalAlignment="Center"/>
                                <TextBlock Text="Plan actual" Style="{StaticResource TituloPasoStyle}"/>
                            </DockPanel>
                            <TextBox Grid.Row="3" x:Name="PlanTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                     TextChanged="Informe_TextChanged"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- ───── Barra de avisos ───── -->
        <Border Grid.Row="2" x:Name="AvisoBorder" Visibility="Collapsed" CornerRadius="6"
                Padding="14,10" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="AvisoIconoText" Style="{StaticResource IconoStyle}" FontSize="18"
                           Margin="0,0,12,0" VerticalAlignment="Top"/>
                <TextBlock Grid.Column="1" x:Name="AvisoText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="2" x:Name="AvisoAccionButton" Visibility="Collapsed" Margin="12,0,0,0"
                        Click="AvisoAccionButton_Click"/>
                <Button Grid.Column="3" ToolTip="Cerrar" Margin="8,0,0,0" Click="CerrarAvisoButton_Click">
                    <TextBlock Style="{StaticResource IconoStyle}" FontSize="12" Text="&#xE711;"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<Version>1.0.0</Version>
	<Product>NeuroDocs</Product>
	<Description>Generación de planes de rehabilitación neuropsicológica</Description>
	<Authors>Mateo Marciglia</Authors>
	<Copyright>© 2026 Mateo Marciglia</Copyright>
	<ApplicationIcon>Assets\NeuroDocs.ico</ApplicationIcon>
	<!-- ThemeMode (tema Fluent) es una API experimental de WPF -->
	<NoWarn>$(NoWarn);WPF0001</NoWarn>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="IA\" />
    <Folder Include="Plantillas\" />
  </ItemGroup>
	
	<ItemGroup>
		<Resource Include="Assets\NeuroDocs.ico" />
		<Resource Include="Assets\NeuroDocs-256.png" />
	</ItemGroup>

  <ItemGroup>
    <None Update="IA\InstruccionesFunciones.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Plantillas\PlantillaPlanRehabilitacion.docx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

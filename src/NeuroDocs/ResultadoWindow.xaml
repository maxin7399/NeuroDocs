<Window x:Class="NeuroDocs.ResultadoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeuroDocs — Datos extraídos" Height="650" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource FondoVentanaBrush}"
        Foreground="{StaticResource TextoPrincipalBrush}"
        Icon="/Assets/NeuroDocs.ico">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0" x:Name="ContenidoTextBox" IsReadOnly="True"
                 FontFamily="Consolas" FontSize="13" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Copiar" Width="100" Height="32" Click="CopiarButton_Click"/>
            <Button Content="Cerrar" Width="100" Height="32" Margin="10,0,0,0"
                    IsCancel="True" Click="CerrarButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
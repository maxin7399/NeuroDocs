<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Superficies -->
    <SolidColorBrush x:Key="FondoVentanaBrush" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="FondoTarjetaBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="BordeTarjetaBrush" Color="#3A3A3A"/>

    <!-- Texto -->
    <SolidColorBrush x:Key="TextoPrincipalBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="TextoSecundarioBrush" Color="#A8A8A8"/>
    <SolidColorBrush x:Key="EnlaceBrush" Color="#60CDFF"/>

    <!-- Acento -->
    <SolidColorBrush x:Key="AcentoBrush" Color="#1F6FC5"/>
    <SolidColorBrush x:Key="AcentoHoverBrush" Color="#2A7FD9"/>
    <SolidColorBrush x:Key="AcentoSuaveBrush" Color="#1E3448"/>
    <SolidColorBrush x:Key="BotonDeshabilitadoBrush" Color="#454545"/>
    <SolidColorBrush x:Key="ExitoBrush" Color="#6CCB5F"/>

    <!-- Barra de avisos -->
    <SolidColorBrush x:Key="AvisoInfoFondoBrush" Color="#1F3346"/>
    <SolidColorBrush x:Key="AvisoInfoIconoBrush" Color="#60CDFF"/>
    <SolidColorBrush x:Key="AvisoExitoFondoBrush" Color="#1E3A1E"/>
    <SolidColorBrush x:Key="AvisoExitoIconoBrush" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="AvisoAdvertenciaFondoBrush" Color="#433519"/>
    <SolidColorBrush x:Key="AvisoAdvertenciaIconoBrush" Color="#FCE100"/>
    <SolidColorBrush x:Key="AvisoErrorFondoBrush" Color="#442726"/>
    <SolidColorBrush x:Key="AvisoErrorIconoBrush" Color="#FF99A4"/>
</ResourceDictionary>